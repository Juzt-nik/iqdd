# Copy this file to .env and adjust as needed. docker-compose.yml currently
# hardcodes most of these directly for simplicity — edit docker-compose.yml
# to reference `${VAR}` from this file if you'd rather not touch the compose
# file itself.

# --- Backend ---
DATABASE_URL=sqlite:////app/storage/iqdd.db
STORAGE_DIR=/app/storage/images
MODEL_DIR=/app/data/models
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
MAX_UPLOAD_MB=15
# Set to "false" to let the backend start even if no trained models are
# found (it will then return 503 on /analyze until models are added) —
# useful for debugging the API/DB layer independently of the ML pipeline.
REQUIRE_MODELS=true

# --- Frontend (build-time only, see frontend/Dockerfile) ---
# Leave empty: nginx reverse-proxies /api and /health to the backend
# container, so the SPA always uses same-origin relative paths.
VITE_API_BASE=
